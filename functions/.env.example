# Copia este archivo a functions/.env (no se versiona) antes de desplegar Functions.
# El CLI de Firebase carga estas variables en las funciones desplegadas (Gen 2).

# Dominios permitidos para CORS — OBLIGATORIO en producción (separados por coma, sin espacios).
# Sin esto, el navegador bloqueará las llamadas a la API desde tu Hosting.
CORS_ORIGINS=https://TU_PROYECTO.web.app,https://TU_PROYECTO.firebaseapp.com,http://localhost:5173

# Activar App Check (solo tras registrar la app web con reCAPTCHA v3):
# ENFORCE_APP_CHECK=true

# Colecciones de Firestore (opcional; estos son los valores por defecto):
# INCIDENTS_COLLECTION=crime_incidents
# ML_PARTS_COLLECTION=ml_model_parts
